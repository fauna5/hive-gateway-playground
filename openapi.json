{
  "openapi": "3.0.3",
  "info": {
    "title": "Nested Data API",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost:3000"
    }
  ],
  "paths": {
    "/data": {
      "get": {
        "summary": "Get nested data",
        "operationId": "getData",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["field1"],
                  "properties": {
                    "field1": {
                      "type": "object",
                      "required": ["subfield1"],
                      "properties": {
                        "subfield1": {
                          "type": "object",
                          "required": ["leafNode1", "leafNode2", "leafnode3"],
                          "properties": {
                            "leafNode1": {
                              "type": "string",
                              "nullable": true
                            },
                            "leafNode2": {
                              "type": "string"
                            },
                            "leafnode3": {
                              "type": "string",
                              "nullable": false
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/payments/update-date": {
      "post": {
        "summary": "Update payment date",
        "operationId": "updatePaymentDate",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdatePaymentDateRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Payment date updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaymentResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "UpdatePaymentDateRequest": {
        "type": "object",
        "required": ["id", "date"],
        "properties": {
          "id": {
            "type": "string",
            "description": "Payment ID"
          },
          "date": {
            "type": "string",
            "format": "date-time",
            "pattern": "^\\d{4}-\\d{2}-\\d{2} \\d{2}:\\d{2}:\\d{2}\\.\\d{6}$",
            "description": "Payment date in format YYYY-MM-DD HH:MM:SS.FFFFFF",
            "example": "2024-12-17 10:30:00.000000"
          }
        }
      },
      "PaymentResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "newDate": {
            "type": "string"
          }
        }
      }
    }
  }
}
